                // Top Grass
                ctx.fillStyle = "#22c55e";
                ctx.fillRect(plat.x, plat.y, plat.width, 6);
                // Dirt Block
                ctx.fillStyle = "#854d0e";
                ctx.fillRect(plat.x, plat.y + 6, plat.width, plat.height - 6);
                // Pixel Outline
                ctx.strokeStyle = "#422006";
                ctx.lineWidth = 2;
                ctx.strokeRect(plat.x, plat.y, plat.width, plat.height);
            });

            // Draw Question Blocks '?'
            questionBlocks.forEach(qb => {
                ctx.fillStyle = qb.solved ? "#64748b" : "#f59e0b";
                ctx.fillRect(qb.x, qb.y, qb.width, qb.height);
                ctx.strokeStyle = "#000000";
                ctx.lineWidth = 2;
                ctx.strokeRect(qb.x, qb.y, qb.width, qb.height);

                if (!qb.solved) {
                    ctx.fillStyle = "#ffffff";
                    ctx.font = "bold 16px 'Press Start 2P', monospace";
                    ctx.fillText("?", qb.x + 8, qb.y + 23);
                }
            });

            // Draw Coins
            coins.forEach(c => {
                if (!c.collected) {
                    ctx.fillStyle = "#facc15";
                    ctx.beginPath();
                    ctx.arc(c.x + c.width / 2, c.y + c.height / 2, c.width / 2, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.strokeStyle = "#ca8a04";
                    ctx.stroke();
                }
            });

            // Draw Enemies (Original Trash Monsters)
            enemies.forEach(en => {
                if (en.x > -100) {
                    ctx.fillStyle = "#ef4444";
                    ctx.fillRect(en.x, en.y, en.width, en.height);
                    // Monster Eyes
                    ctx.fillStyle = "#ffffff";
                    ctx.fillRect(en.x + 4, en.y + 6, 6, 6);
                    ctx.fillRect(en.x + 18, en.y + 6, 6, 6);
                    ctx.fillStyle = "#000000";
                    ctx.fillRect(en.x + 6, en.y + 8, 3, 3);
                    ctx.fillRect(en.x + 20, en.y + 8, 3, 3);
                }
            });

            // Draw Goal Gate
            ctx.fillStyle = "#3b82f6";
            ctx.fillRect(goalGate.x, goalGate.y, goalGate.width, goalGate.height);
            ctx.fillStyle = "#f59e0b";
            ctx.font = "bold 10px 'Press Start 2P', monospace";
            ctx.fillText("GERBANG", goalGate.x - 5, goalGate.y - 10);

            // Draw Player (Original Retro Hero)
            ctx.fillStyle = "#3b82f6"; // Blue Body
            ctx.fillRect(player.x, player.y + 12, player.width, player.height - 12);
            ctx.fillStyle = "#f43f5e"; // Red Shirt/Cap
            ctx.fillRect(player.x + 2, player.y, player.width - 4, 12);
            // Face
            ctx.fillStyle = "#fed7aa";
            ctx.fillRect(player.x + (player.facing === 'right' ? 10 : 2), player.y + 8, 14, 10);

            ctx.restore();
        }

        /* ==========================================================================
           5. QUIZ / EDUCATIONAL CHALLENGE MODAL LOGIC
           ========================================================================== */
        function triggerQuizModal(qb) {
            gameState.isPaused = true;
            activeQuizBlock = qb;
            const qData = qb.question;

            document.getElementById('quizCategory').textContent = gameState.subject;
            document.getElementById('quizQuestion').textContent = qData.q;
            document.getElementById('quizFeedback').className = "hidden p-3 rounded-lg text-sm mb-4";
            document.getElementById('quizFooter').classList.add('hidden');

            const optionsContainer = document.getElementById('quizOptions');
            optionsContainer.innerHTML = '';

            qData.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left bg-slate-800 hover:bg-slate-700 border border-slate-700 p-3.5 rounded-xl text-xs md:text-sm text-slate-200 transition flex items-start gap-3";
                btn.innerHTML = `
                    <span class="font-bold pixel-font text-amber-400 bg-slate-900 px-2 py-1 rounded text-xs">${String.fromCharCode(65 + idx)}</span>
                    <span class="flex-grow">${optText}</span>
                `;
                btn.onclick = () => handleAnswerSelect(idx, qData, btn);
                optionsContainer.appendChild(btn);
            });

            document.getElementById('modalQuiz').classList.remove('hidden');
        }

        function handleAnswerSelect(selectedIdx, qData, btnElement) {
            gameState.totalQuestionsAnswered += 1;
            const isCorrect = (selectedIdx === qData.correct);

            const feedback = document.getElementById('quizFeedback');
            feedback.classList.remove('hidden');

            // Disable all option buttons
            const allBtns = document.getElementById('quizOptions').querySelectorAll('button');
            allBtns.forEach(b => b.disabled = true);

            if (isCorrect) {
                gameState.correctAnswers += 1;
                gameState.score += 200;
                gameState.coins += 5;
                playSound('correct');

                btnElement.classList.add('bg-emerald-900/80', 'border-emerald-500');
                feedback.className = "p-3 rounded-lg text-xs md:text-sm mb-4 bg-emerald-950 border border-emerald-500 text-emerald-300";
                feedback.innerHTML = `<b><i class="fa-solid fa-circle-check"></i> TEPAT ON POINT!</b><br>${qData.exp}`;
                
                if (activeQuizBlock) activeQuizBlock.solved = true;
            } else {
                gameState.wrongAnswers += 1;
                playSound('wrong');

                btnElement.classList.add('bg-red-900/80', 'border-red-500');
                feedback.className = "p-3 rounded-lg text-xs md:text-sm mb-4 bg-red-950 border border-red-500 text-red-300";
                feedback.innerHTML = `<b><i class="fa-solid fa-circle-xmark"></i> KURANG TEPAT!</b><br>${qData.exp}`;
            }

            updateHUD();
            document.getElementById('quizFooter').classList.remove('hidden');
        }

        function closeQuizModal() {
            document.getElementById('modalQuiz').classList.add('hidden');
            gameState.isPaused = false;
        }

        /* ==========================================================================
           6. HUD, PAUSE, & PROGRESS SYSTEM
           ========================================================================== */
        function updateHUD() {
            document.getElementById('hudName').textContent = gameState.playerName.toUpperCase();
            document.getElementById('hudLives').textContent = 'x' + gameState.lives;
            document.getElementById('hudCoins').textContent = String(gameState.coins).padStart(2, '0');
            document.getElementById('hudScore').textContent = String(gameState.score).padStart(5, '0');
            document.getElementById('hudLevel').textContent = `${gameState.currentLevelIndex + 1}-1`;
        }

        function togglePause() {
            gameState.isPaused = !gameState.isPaused;
            const btn = document.getElementById('btnPause');
            if (gameState.isPaused) {
                btn.innerHTML = '<i class="fa-solid fa-play"></i>';
            } else {
                btn.innerHTML = '<i class="fa-solid fa-pause"></i>';
            }
        }

        function levelCompleted() {
            gameState.isPaused = true;
            playSound('correct');

            if (gameState.currentLevelIndex + 1 >= levelsData.length) {
                showFinalResults(true);
            } else {
                if (gameState.unlockedLevels <= gameState.currentLevelIndex + 1) {
                    gameState.unlockedLevels = gameState.currentLevelIndex + 2;
                }
                alert(`SELAMAT! Kamu menyelesaikan ${levelsData[gameState.currentLevelIndex].name}!`);
                switchScreen('screenWorldMap');
            }
        }

        function gameOver() {
            gameState.isPaused = true;
            playSound('wrong');
            alert("GAME OVER! Nyawa kamu telah habis. Jangan menyerah, mari lihat hasil belajar dan coba kembali!");
            showFinalResults(false);
        }

        /* ==========================================================================
           7. FINAL RECAPITULATION & HOME RETURN
           ========================================================================== */
        function showFinalResults(isWin) {
            switchScreen('screenResult');

            document.getElementById('resultTitle').textContent = isWin ? "PETUALANGAN SELESAI — JUARA!" : "GAME OVER — COBA LAGI!";
            document.getElementById('resName').textContent = gameState.playerName;
            document.getElementById('resGrade').textContent = gameState.grade;
            document.getElementById('resSchool').textContent = gameState.school;
            document.getElementById('resTeacher').textContent = gameState.teacher;

            document.getElementById('resScore').textContent = gameState.score;
            document.getElementById('resCoins').textContent = gameState.coins;
            document.getElementById('resRightWrong').textContent = `${gameState.correctAnswers} / ${gameState.wrongAnswers}`;

            const total = gameState.totalQuestionsAnswered;
            const accuracy = total > 0 ? Math.round((gameState.correctAnswers / total) * 100) : 0;
            document.getElementById('resAccuracy').textContent = `${accuracy}%`;

            const feedbackEl = document.getElementById('resFeedback');
            if (accuracy >= 80) {
                feedbackEl.innerHTML = `<b>Luar Biasa!</b> Pemahaman kamu mengenai <i>${gameState.topic}</i> sangat mantap. Kamu telah mengidentifikasi jenis limbah dan cara pemanfaatannya dengan sangat presisi. Tetap tingkatkan kepedulian lingkungan!`;
            } else if (accuracy >= 50) {
                feedbackEl.innerHTML = `<b>Bagus!</b> Kamu sudah memahami konsep dasar pengolahan limbah organik dan anorganik. Disarankan untuk membaca kembali materi dampak limbah anorganik dan cara kreasi 3R.`;
            } else {
                feedbackEl.innerHTML = `<b>Tetap Semangat!</b> Materi pengolahan limbah memerlukan pemahaman ulang. Jangan ragu untuk bertanya kepada Bpk/Ibu <b>${gameState.teacher}</b> dan mengulang permainan ini.`;
            }
        }

        function finishGameAndGoHome() {
            // Reset Progress Game State
            gameState.score = 0;
            gameState.coins = 0;
            gameState.lives = 3;
            gameState.totalQuestionsAnswered = 0;
            gameState.correctAnswers = 0;
            gameState.wrongAnswers = 0;
            gameState.currentLevelIndex = 0;
            gameState.unlockedLevels = 1;

            switchScreen('screenLanding');
        }

        // Initialize HUD Default on Load
        window.onload = function() {
            updateHUD();
        };
    </script>
</body>
</html>

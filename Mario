            teacher: "Desman Manik, S.Pd",
            school: "SMP Tunas Harapan",
            
            currentLevelIndex: 0,
            score: 0,
            coins: 0,
            lives: 3,
            
            totalQuestionsAnswered: 0,
            correctAnswers: 0,
            wrongAnswers: 0,
            
            isPaused: false,
            audioMuted: false,
            unlockedLevels: 1
        };


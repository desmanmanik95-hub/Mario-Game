<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Petualangan Edutainment Retro Platformer</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Font Pixel Art / Retro -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            user-select: none;
            -webkit-user-select: none;
            overflow-x: hidden;
            touch-action: manipulation;
        }

        .pixel-font {
            font-family: 'Press Start 2P', cursive;
        }

        /* Canvas Style */
        #gameCanvas {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            background-color: #5c94fc;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
            border-radius: 8px;
            width: 100%;
            max-width: 960px;
            height: auto;
            aspect-ratio: 16 / 9;
        }

        /* Retro Button Effects */
        .btn-retro {
            position: relative;
            box-shadow: inset -4px -4px 0px 0px #00000040, inset 4px 4px 0px 0px #ffffff40;
            transition: all 0.1s ease;
        }
        .btn-retro:active {
            box-shadow: inset 2px 2px 0px 0px #00000040;
            transform: translateY(2px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b82f6;
            border-radius: 4px;
        }

        /* Floating Animation */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-slate-950 text-white">

    <!-- HEADER / NAVIGATION HUD -->
    <header id="gameHeader" class="bg-slate-900 border-b-4 border-amber-500 p-3 hidden sticky top-0 z-40">
        <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2 text-xs md:text-sm pixel-font">
            <!-- Left Info -->
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1 text-amber-400">
                    <i class="fa-solid fa-user text-xs"></i>
                    <span id="hudName" class="truncate max-w-[100px] md:max-w-[150px]">MURID</span>
                </div>
                <div class="flex items-center gap-1 text-red-500">
                    <i class="fa-solid fa-heart text-xs"></i>
                    <span id="hudLives">x3</span>
                </div>
            </div>

            <!-- Middle Info -->
            <div class="flex items-center gap-4">
                <div class="text-yellow-400 flex items-center gap-1">
                    <i class="fa-solid fa-coins text-xs"></i>
                    <span id="hudCoins">00</span>
                </div>
                <div class="text-emerald-400">
                    SKOR: <span id="hudScore">00000</span>
                </div>
            </div>

            <!-- Right Info -->
            <div class="flex items-center gap-3">
                <div class="text-cyan-400">
                    DUNIA: <span id="hudLevel">1-1</span>
                </div>
                <button id="btnMute" onclick="toggleAudio()" class="bg-slate-800 hover:bg-slate-700 px-2 py-1 rounded text-white border border-slate-600">
                    <i id="audioIcon" class="fa-solid fa-volume-high"></i>
                </button>
                <button id="btnPause" onclick="togglePause()" class="bg-amber-600 hover:bg-amber-500 px-2 py-1 rounded text-white border border-amber-400">
                    <i class="fa-solid fa-pause"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-grow flex items-center justify-center p-2 md:p-4">

        <!-- 1. HALAMAN PEMBUKA (LANDING PAGE) -->
        <section id="screenLanding" class="w-full max-w-4xl bg-slate-900/90 border-4 border-amber-500 rounded-2xl p-6 md:p-10 text-center shadow-2xl backdrop-blur relative overflow-hidden">
            <div class="absolute -right-10 -top-10 w-40 h-40 bg-amber-500/10 rounded-full blur-3xl"></div>
            <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-blue-500/10 rounded-full blur-3xl"></div>
            
            <div class="animate-float mb-6">
                <div class="inline-block bg-amber-500 text-slate-950 font-bold px-4 py-1 rounded-full text-xs md:text-sm mb-3 uppercase tracking-wider">
                    Game Edukasi Platformer Retro 3D/2D
                </div>
                <h1 class="pixel-font text-2xl md:text-4xl text-amber-400 drop-shadow-[0_4px_0_#92400e] leading-relaxed">
                    SUPER ECO ADVENTURE
                </h1>
                <p class="text-slate-300 text-sm md:text-base mt-2 max-w-lg mx-auto">
                    Jelajahi dunia piksel, pecahkan blok misteri, kelola limbah organik & anorganik, dan jadilah Pahlawan Lingkungan!
                </p>
            </div>

            <!-- Retro Pixel Art Preview Mock -->
            <div class="bg-sky-400 border-4 border-slate-800 rounded-xl p-4 max-w-md mx-auto mb-8 shadow-inner flex items-center justify-between relative overflow-hidden h-32">
                <div class="w-8 h-8 bg-amber-400 border-2 border-black rounded flex items-center justify-center font-bold pixel-font animate-bounce">?</div>
                <div class="w-10 h-14 bg-red-500 rounded-t-lg border-2 border-black relative flex flex-col justify-end items-center">
                    <div class="w-12 h-3 bg-blue-600 rounded"></div>
                </div>
                <div class="w-8 h-8 bg-emerald-700 rounded-full border-2 border-black"></div>
                <div class="absolute bottom-0 left-0 right-0 h-6 bg-amber-800 border-t-2 border-black"></div>
            </div>

            <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
                <button onclick="switchScreen('screenIdentity')" class="btn-retro bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-base md:text-lg px-8 py-4 rounded-xl pixel-font flex items-center gap-3 w-full md:w-auto justify-center">
                    <i class="fa-solid fa-play"></i> MULAI PETUALANGAN
                </button>
                <button onclick="switchScreen('screenInstructions')" class="btn-retro bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm px-6 py-4 rounded-xl flex items-center gap-2 border border-slate-700 w-full md:w-auto justify-center">
                    <i class="fa-solid fa-circle-info"></i> CARA BERMAIN
                </button>
            </div>
        </section>

        <!-- 2. HALAMAN IDENTITAS & MATERI -->
        <section id="screenIdentity" class="w-full max-w-3xl bg-slate-900 border-4 border-blue-500 rounded-2xl p-6 md:p-8 shadow-2xl hidden">
            <div class="border-b border-slate-800 pb-4 mb-6 text-center">
                <h2 class="pixel-font text-xl text-blue-400">IDENTITAS & MATERI GAME</h2>
                <p class="text-xs text-slate-400 mt-1">Lengkapi data diri dan konfirmasi materi pembelajaran sebelum bertualang.</p>
            </div>

            <form id="identityForm" onsubmit="event.preventDefault(); startJourney();" class="space-y-4 text-sm">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Nama Murid *</label>
                        <input type="text" id="inputName" required placeholder="Masukkan nama lengkap" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Jenjang & Kelas *</label>
                        <select id="inputGrade" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                            <option value="SMP - Kelas 9 (Fase D)">SMP - Kelas 9 (Fase D)</option>
                            <option value="SD - Kelas 4-6 (Fase B/C)">SD - Kelas 4-6 (Fase B/C)</option>
                            <option value="SMA - Kelas 10-12 (Fase E/F)">SMA - Kelas 10-12 (Fase E/F)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Mata Pelajaran</label>
                        <input type="text" id="inputSubject" value="Lintas Mata Pelajaran (IPA & Prakarya)" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Semester</label>
                        <input type="text" id="inputSemester" value="1 (Ganjil)" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>

                <div>
                    <label class="block text-slate-300 font-semibold mb-1">Materi Utama & Submateri</label>
                    <input type="text" id="inputTopic" value="Pengolahan Limbah Organik & Anorganik Menjadi Barang Bernilai Guna" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Nama Guru / Pendidik</label>
                        <input type="text" id="inputTeacher" value="Desman Manik, S.Pd" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1">Nama Sekolah</label>
                        <input type="text" id="inputSchool" value="SMP Tunas Harapan" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>

                <div class="pt-4 flex gap-3">
                    <button type="button" onclick="switchScreen('screenLanding')" class="w-1/3 bg-slate-800 hover:bg-slate-700 text-slate-300 py-3 rounded-xl font-bold transition">
                        Kembali
                    </button>
                    <button type="submit" class="w-2/3 btn-retro bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold py-3 rounded-xl pixel-font flex items-center justify-center gap-2">
                        PETUALANGAN DIMULAI <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </section>

        <!-- 3. HALAMAN PETUNJUK -->
        <section id="screenInstructions" class="w-full max-w-3xl bg-slate-900 border-4 border-amber-500 rounded-2xl p-6 md:p-8 shadow-2xl hidden">
            <h2 class="pixel-font text-xl text-amber-400 mb-4 text-center">PETUNJUK PERMAINAN</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm mb-6">
                <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700">
                    <h3 class="font-bold text-amber-400 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-keyboard"></i> Kontrol Komputer
                    </h3>
                    <ul class="space-y-1.5 text-slate-300">
                        <li><b class="text-white">A / D</b> atau <b class="text-white">Panah Kiri/Kanan</b> : Bergerak</li>
                        <li><b class="text-white">W / Spasi / Panah Atas</b> : Melompat</li>
                        <li><b class="text-white">Enter</b> : Konfirmasi / Pilih Jawaban</li>
                        <li><b class="text-white">Esc</b> : Pause / Jeda Game</li>
                    </ul>
                </div>

                <div class="bg-slate-800/80 p-4 rounded-xl border border-slate-700">
                    <h3 class="font-bold text-amber-400 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-mobile-screen"></i> Kontrol HP / Tablet
                    </h3>
                    <p class="text-slate-300 leading-relaxed">
                        Gunakan tombol virtual di layar: <br>
                        - Tombol Panah Kiri/Kanan di sudut bawah kiri.<br>
                        - Tombol **LOMPAT** besar di sudut bawah kanan.
                    </p>
                </div>
            </div>

            <div class="bg-amber-950/40 border border-amber-500/40 p-4 rounded-xl text-slate-200 text-xs md:text-sm space-y-2 mb-6">
                <p class="font-bold text-amber-300 flex items-center gap-2">
                    <i class="fa-solid fa-lightbulb"></i> Misi & Fitur Game:
                </p>
                <p>1. Sundul blok misteri <span class="bg-amber-500 text-black px-1.5 py-0.5 font-bold rounded">?</span> dari bawah untuk memunculkan soal edukasi.</p>
                <p>2. Jawab pertanyaan dengan benar untuk memperoleh poin, koin, dan membuka gerbang rintangan.</p>
                <p>3. Hindari atau lewati musuh Monster Sampah agar nyawa tidak berkurang.</p>
            </div>

            <div class="text-center">
                <button onclick="switchScreen('screenLanding')" class="btn-retro bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-8 py-3 rounded-xl pixel-font">
                    SAYA MENGERTI
                </button>
            </div>
        </section>

        <!-- 4. PETA DUNIA / WORLD MAP -->
        <section id="screenWorldMap" class="w-full max-w-4xl bg-slate-900 border-4 border-emerald-500 rounded-2xl p-6 md:p-8 shadow-2xl hidden">
            <div class="text-center mb-6">
                <h2 class="pixel-font text-xl md:text-2xl text-emerald-400 mb-1">PETA DUNIA PETUALANGAN</h2>
                <p class="text-xs md:text-sm text-slate-300">Pilih level yang terbuka untuk melanjutkan misi edukasi.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-8" id="levelGrid">
                <!-- Level Cards dynamically injected -->
            </div>

            <div class="flex justify-between items-center border-t border-slate-800 pt-4 text-xs text-slate-400">
                <span id="playerInfoSummary">Pemain: -</span>
                <button onclick="switchScreen('screenLanding')" class="bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg text-white">
                    Menu Utama
                </button>
            </div>
        </section>

        <!-- 5. ARENA PERMAINAN (GAME CANVAS CONTAINER) -->
        <section id="screenGame" class="w-full max-w-4xl flex flex-col items-center hidden relative">
            <div class="relative w-full">
                <!-- Canvas -->
                <canvas id="gameCanvas" width="800" height="450"></canvas>

                <!-- Touch Controls Overlay (Mobile Only) -->
                <div id="touchControls" class="md:hidden absolute inset-0 pointer-events-none flex justify-between items-end p-4 z-20">
                    <!-- Left / Right D-Pad -->
                    <div class="flex gap-2 pointer-events-auto">
                        <button id="btnLeft" class="w-14 h-14 bg-slate-900/80 active:bg-amber-500 text-white rounded-full border-2 border-white/50 text-xl flex items-center justify-center">
                            <i class="fa-solid fa-arrow-left"></i>
                        </button>
                        <button id="btnRight" class="w-14 h-14 bg-slate-900/80 active:bg-amber-500 text-white rounded-full border-2 border-white/50 text-xl flex items-center justify-center">
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>

                    <!-- Jump Button -->
                    <div class="pointer-events-auto">
                        <button id="btnJump" class="w-16 h-16 bg-amber-500 active:bg-amber-400 text-slate-950 font-black rounded-full border-2 border-white text-xs pixel-font shadow-lg flex items-center justify-center">
                            LOMPAT
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. MODAL TANTANGAN / KUIS -->
        <div id="modalQuiz" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
            <div class="bg-slate-900 border-4 border-amber-400 rounded-2xl max-w-xl w-full p-6 shadow-2xl relative animate-float">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
                    <span class="pixel-font text-xs text-amber-400 bg-amber-950/80 px-2.5 py-1 rounded border border-amber-500/50 flex items-center gap-2">
                        <i class="fa-solid fa-cube"></i> TANTANGAN BLOK MISTERI
                    </span>
                    <span id="quizCategory" class="text-xs text-slate-400">Mapel IPA</span>
                </div>

                <h3 id="quizQuestion" class="text-base md:text-lg font-bold text-white mb-6 leading-relaxed">
                    Pertanyaan akan muncul di sini...
                </h3>

                <div id="quizOptions" class="space-y-3 mb-6">
                    <!-- Dynamic Options -->
                </div>

                <!-- Feedback Box -->
                <div id="quizFeedback" class="hidden p-3 rounded-lg text-sm mb-4"></div>

                <div id="quizFooter" class="flex justify-end hidden">
                    <button id="btnContinueQuiz" onclick="closeQuizModal()" class="btn-retro bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-6 py-2.5 rounded-lg text-sm pixel-font">
                        LANJUTKAN <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 7. HALAMAN HASIL / REKAPITULASI -->
        <section id="screenResult" class="w-full max-w-3xl bg-slate-900 border-4 border-amber-500 rounded-2xl p-6 md:p-8 shadow-2xl hidden">
            <div class="text-center mb-6">
                <div class="inline-block bg-amber-500/20 text-amber-400 border border-amber-500/40 rounded-full px-4 py-1 text-xs font-bold mb-2">
                    REKAPITULASI HASIL BELAJAR
                </div>
                <h2 id="resultTitle" class="pixel-font text-2xl text-amber-400">PETUALANGAN SELESAI!</h2>
            </div>

            <!-- Identitas Header -->
            <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs mb-6">
                <div>
                    <span class="text-slate-400 block">Nama Murid:</span>
                    <strong id="resName" class="text-white text-sm">---</strong>
                </div>
                <div>
                    <span class="text-slate-400 block">Kelas/Jenjang:</span>
                    <strong id="resGrade" class="text-white text-sm">---</strong>
                </div>
                <div>
                    <span class="text-slate-400 block">Sekolah:</span>
                    <strong id="resSchool" class="text-white text-sm">---</strong>
                </div>
                <div>
                    <span class="text-slate-400 block">Guru Pengampu:</span>
                    <strong id="resTeacher" class="text-white text-sm">---</strong>
                </div>
            </div>

            <!-- Score Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-center">
                    <span class="text-slate-400 text-xs">Total Skor Game</span>
                    <p id="resScore" class="pixel-font text-amber-400 text-lg md:text-xl mt-1">0</p>
                </div>
                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-center">
                    <span class="text-slate-400 text-xs">Akurasi Jawaban</span>
                    <p id="resAccuracy" class="pixel-font text-emerald-400 text-lg md:text-xl mt-1">0%</p>
                </div>
                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-center">
                    <span class="text-slate-400 text-xs">Benar / Salah</span>
                    <p id="resRightWrong" class="pixel-font text-cyan-400 text-sm md:text-base mt-2">0 / 0</p>
                </div>
                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-center">
                    <span class="text-slate-400 text-xs">Koin Dikumpul</span>
                    <p id="resCoins" class="pixel-font text-yellow-400 text-lg md:text-xl mt-1">0</p>
                </div>
            </div>

            <!-- Academic Evaluation -->
            <div class="bg-slate-800/50 p-4 rounded-xl border border-slate-700 mb-6 space-y-3">
                <h4 class="font-bold text-amber-400 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-graduation-cap"></i> Evaluasi Penguasaan Materi
                </h4>
                <p id="resFeedback" class="text-xs md:text-sm text-slate-300 leading-relaxed">
                    Umpan balik materi...
                </p>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
                <button onclick="finishGameAndGoHome()" class="btn-retro bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold px-8 py-3.5 rounded-xl pixel-font text-xs md:text-sm flex items-center justify-center gap-2">
                    <i class="fa-solid fa-house"></i> OKE & KEMBALI KE BERANDA
                </button>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-900 border-t border-slate-800 py-3 text-center text-xs text-slate-500">
        Media Pembelajaran Interaktif Platformer &copy; 2026 - SMP Tunas Harapan
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        /* ==========================================================================
           1. DATA STRUCTURES & GLOBAL STATE
           ========================================================================== */
        const gameState = {
            playerName: "Murid",
            grade: "SMP - Kelas 9 (Fase D)",
            subject: "Lintas Mata Pelajaran",
